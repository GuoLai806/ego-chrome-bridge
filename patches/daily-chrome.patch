+  const own = (await call(a,"listTabs",x.id)).tabs[0];
+  assert.notEqual(own.targetId,"private");
+  assert.equal(calls.some(c=>c.method==="Target.createBrowserContext"),false);
+  targets.push({targetId:"popup",type:"page",openerId:own.targetId});
+  targets.push({targetId:"private-popup",type:"page",openerId:"private"});
+  assert.deepEqual((await call(a,"listTabs",x.id)).tabs.map(t=>t.targetId),[own.targetId,"popup"]);
+  for (const method of ["Target.attachToTarget","Target.activateTarget","Target.closeTarget"])
+    await assert.rejects(call(a,"cdp",x.id,[{method,params:{targetId:"private"}}]),{error_code:"EGO_WEB_CONTENTS_UNAVAILABLE"});
+  await assert.rejects(call(a,"cdp",x.id,[{method:"Browser.close"}]),{error_code:"EGO_CDP_SEND_FAILED"});
+  await call(a,"closeTaskSpace",x.id);
+  assert.deepEqual(calls.filter(c=>c.method==="Target.closeTarget").map(c=>c.params.targetId),[own.targetId,"popup"]);
+  assert.equal(calls.some(c=>c.method==="Target.disposeBrowserContext"),false);
+});
+test("daily Chrome does not absorb unknown tabs or another task's popup", async () => {
