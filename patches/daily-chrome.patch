+  const yt=(await call(b,"listTabs",y.id)).tabs[0].targetId;
+  targets.push({targetId:"ypop",type:"page",openerId:yt},{targetId:"unknown",type:"page"});
+  assert.equal((await call(a,"listTabs",x.id)).tabs.length,1);
+  assert.equal((await call(b,"listTabs",y.id)).tabs.length,2);
+});
